# Real email sending (Resend) — https://resend.com/api-keys
RESEND_API_KEY=

# Optional: custom verified sender. Defaults to the Resend test sender.
# In Resend test mode you can ONLY send to your own account email.
# Verify a domain at https://resend.com/domains to email anyone.
# EMAIL_FROM=Matt Lane Photography <invoices@yourdomain.com>

# Optional: absolute base URL used to build the Pay link in emails.
# Defaults to the request host (e.g. http://localhost:4319).
# APP_URL=https://your-deploy-url.com

# Voice dictation (OpenAI) — https://platform.openai.com/api-keys
# Used for speech-to-text (Whisper) and parsing dictation into form fields.
OPENAI_API_KEY=
